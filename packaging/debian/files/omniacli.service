[Unit]
Description=OmniaCLI, web service to deploy Odoo instances
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=omniacli
Group=omniacli
Environment=OMNIACLI_CONFIG=/etc/omniacli/omniacli.yaml
Environment=OMNIACLI_HOST=127.0.0.1
Environment=OMNIACLI_PORT=8090
EnvironmentFile=-/etc/default/omniacli
WorkingDirectory=/var/lib/omniacli
ExecStart=/opt/omniacli/venv/bin/omniacli serve -c ${OMNIACLI_CONFIG} --host ${OMNIACLI_HOST} --port ${OMNIACLI_PORT}
Restart=on-failure
RestartSec=5
# stop only OmniaCLI: the Odoo instances it starts itself (restart type
# process) keep running across its restarts and upgrades
KillMode=process
# no NoNewPrivileges: the restart of the Odoo services goes through sudo

[Install]
WantedBy=multi-user.target
