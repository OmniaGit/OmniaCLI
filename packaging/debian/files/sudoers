# OmniaCLI restarts the Odoo services with "sudo -n". Allow each service here,
# with exactly the command OmniaCLI runs (see the job log), for example:
#
# omniacli ALL=(root) NOPASSWD: /usr/bin/systemctl --no-ask-password restart odoo-prod
# omniacli ALL=(root) NOPASSWD: /etc/init.d/odoo-test restart
#
# Check the file after every change: visudo -cf /etc/sudoers.d/omniacli
