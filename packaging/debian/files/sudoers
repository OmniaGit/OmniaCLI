# OmniaCLI restarts the Odoo services with "sudo -n". Allow each service here,
# with exactly the command OmniaCLI runs (see the job log), for example:
# (with OMNIACLI_USER in /etc/default/omniacli, the lines name that user)
#
# omniacli ALL=(root) NOPASSWD: /usr/bin/systemctl --no-ask-password restart odoo-prod
# omniacli ALL=(root) NOPASSWD: /etc/init.d/odoo-test restart
#
# The Start and Stop buttons of a systemd service need its start and stop:
#
# omniacli ALL=(root) NOPASSWD: /usr/bin/systemctl --no-ask-password start odoo-prod
# omniacli ALL=(root) NOPASSWD: /usr/bin/systemctl --no-ask-password stop odoo-prod
#
# An instance with run_as runs its venv's programs as that user: allow the
# venv's bin folder (the "Run as" check prints the line), for example:
#
# omniacli ALL=(odoo) NOPASSWD:SETENV: /opt/odoo/venvs/odoo18/bin/
#
# The psql page of such an instance runs psql as that user (the "psql" check
# prints the line):
#
# omniacli ALL=(odoo) NOPASSWD:SETENV: /usr/bin/psql
#
# An instance installed from a signed Debian package needs its install, with
# ':' and '=' escaped (the "Package install permission" check prints it):
#
# omniacli ALL=(root) NOPASSWD: /usr/bin/apt-get install -y -o Dpkg\:\:Options\:\:\=--force-confdef -o Dpkg\:\:Options\:\:\=--force-confold /var/lib/omniacli/packages/api_production.deb
#
# Check the file after every change: visudo -cf /etc/sudoers.d/omniacli
