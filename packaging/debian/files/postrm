set -e

case "$1" in
    remove)
        # the workspaces' helpers are gone with the venv
        rm -f /etc/sudoers.d/omniacli-workspaces
        rm -rf /opt/omniacli/venv /opt/omniacli/venv.old /opt/omniacli/python /opt/omniacli/python.old /opt/omniacli/.python.*
        ;;
    purge)
        rm -f /etc/sudoers.d/omniacli-workspaces
        rm -rf /opt/omniacli/venv /opt/omniacli/venv.old /opt/omniacli/python /opt/omniacli/python.old /opt/omniacli/.python.*
        rm -f /etc/omniacli/omniacli.yaml /etc/omniacli/initial-admin-password
        rm -f /etc/systemd/system/omniacli.service.d/omniacli-user.conf
        rmdir /etc/systemd/system/omniacli.service.d 2>/dev/null || true
        rmdir /etc/omniacli 2>/dev/null || true
        # the configuration, the histories, the logs and the scripts go; the
        # backups stay
        rm -rf /var/lib/omniacli/jobs /var/lib/omniacli/logs /var/lib/omniacli/scripts \
            /var/lib/omniacli/pullers /var/lib/omniacli/publications /var/lib/omniacli/connections \
            /var/lib/omniacli/packages /var/lib/omniacli/plugins
        rm -f /var/lib/omniacli/servers.yaml /var/lib/omniacli/servers.yaml.bak \
            /var/lib/omniacli/servers.yaml.tmp \
            /var/lib/omniacli/users.yaml /var/lib/omniacli/users.yaml.tmp \
            /var/lib/omniacli/links.yaml /var/lib/omniacli/links.yaml.tmp \
            /var/lib/omniacli/groups.yaml /var/lib/omniacli/groups.yaml.tmp \
            /var/lib/omniacli/options.yaml /var/lib/omniacli/options.yaml.tmp \
            /var/lib/omniacli/pullers.yaml /var/lib/omniacli/pullers.yaml.tmp \
            /var/lib/omniacli/publications.yaml /var/lib/omniacli/publications.yaml.tmp \
            /var/lib/omniacli/connections.yaml /var/lib/omniacli/connections.yaml.tmp \
            /var/lib/omniacli/schedules.yaml /var/lib/omniacli/schedules.yaml.tmp \
            /var/lib/omniacli/schedule_history.json /var/lib/omniacli/schedule_history.json.tmp \
            /var/lib/omniacli/disk_history.json /var/lib/omniacli/disk_history.tmp \
            /var/lib/omniacli/sessions.json /var/lib/omniacli/sessions.json.tmp
        if [ -d /var/lib/omniacli/backups ] && [ -n "$(ls -A /var/lib/omniacli/backups)" ]; then
            echo "omniacli: the database backups are kept in /var/lib/omniacli/backups"
        else
            rm -rf /var/lib/omniacli
        fi
        ;;
esac

# systemd, as dh_installsystemd writes it
if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi
if [ "$1" = "remove" ] && [ -x "/usr/bin/deb-systemd-helper" ]; then
    deb-systemd-helper mask 'omniacli.service' >/dev/null || true
fi
if [ "$1" = "purge" ] && [ -x "/usr/bin/deb-systemd-helper" ]; then
    deb-systemd-helper purge 'omniacli.service' >/dev/null || true
    deb-systemd-helper unmask 'omniacli.service' >/dev/null || true
fi

exit 0
