set -e

VENV=/opt/omniacli/venv
CONFIG=/etc/omniacli/omniacli.yaml
PASSWORD_FILE=/etc/omniacli/initial-admin-password
DATA=/var/lib/omniacli
# written from OMNIACLI_USER of /etc/default/omniacli, removed without it
USER_DROPIN=/etc/systemd/system/omniacli.service.d/omniacli-user.conf

BUNDLED=/opt/omniacli/python
# The Python for a machine without any python3.10+ (Debian 11 has 3.9): a
# python-build-standalone build, downloaded once and checked against its sha256
BUNDLED_URL=https://github.com/astral-sh/python-build-standalone/releases/download/20261020/cpython-3.12.15%2B20261020-x86_64-unknown-linux-gnu-install_only_stripped.tar.gz
BUNDLED_SHA256=7d6ef1164fb94c4b60d913340610fc7e0ef8e3d1b705aa5628b299b08cbdd4b5

# Print py<major><minor> of a Python 3.10+ that can build the venv, fail otherwise.
usable() {
    "$1" -c 'import sys, ssl, zlib, ensurepip, venv
assert sys.version_info >= (3, 10)
print("py%d%d" % sys.version_info[:2])' 2>/dev/null
}

# Download the bundled Python into $BUNDLED, unless it is there already. The
# previous one is kept in $BUNDLED.old until the venv is built on the new one.
fetch_bundled() {
    [ "$(cat "$BUNDLED/.sha256" 2>/dev/null)" = "$BUNDLED_SHA256" ] && return 0
    if [ "$(uname -m)" != x86_64 ]; then
        echo "omniacli: no python3.10 or newer here, and the bundled Python is for x86_64 only: install python3.10+" >&2
        exit 1
    fi
    echo "omniacli: $(python3 -V 2>&1) and no python3.10+ here: downloading Python 3.12 into $BUNDLED"
    tmp=$(mktemp -d /opt/omniacli/.python.XXXXXX)
    if ! python3 - "$BUNDLED_URL" "$BUNDLED_SHA256" "$tmp/python.tar.gz" <<'EOF'
import hashlib, sys, urllib.request
url, sha256, dest = sys.argv[1:]
digest = hashlib.sha256()
with urllib.request.urlopen(url, timeout=60) as response, open(dest, "wb") as out:
    for chunk in iter(lambda: response.read(1 << 20), b""):
        digest.update(chunk)
        out.write(chunk)
if digest.hexdigest() != sha256:
    sys.exit("sha256 %s, expected %s" % (digest.hexdigest(), sha256))
EOF
    then
        rm -rf "$tmp"
        echo "omniacli: Python could not be downloaded from $BUNDLED_URL (is github.com reachable?)" >&2
        exit 1
    fi
    tar -xzf "$tmp/python.tar.gz" -C "$tmp"
    echo "$BUNDLED_SHA256" > "$tmp/python/.sha256"
    rm -rf "$BUNDLED.old"
    [ -d "$BUNDLED" ] && mv "$BUNDLED" "$BUNDLED.old"
    mv "$tmp/python" "$BUNDLED"
    rm -rf "$tmp"
}

# The Python of the venv: the system python3 when it is 3.10+, otherwise a
# local python3.10+ (the newest), otherwise the bundled one. Each must have a
# lock for its version.
pick_python() {
    for py in python3 python3.13 python3.12 python3.11 python3.10 \
              /usr/local/bin/python3.13 /usr/local/bin/python3.12 \
              /usr/local/bin/python3.11 /usr/local/bin/python3.10; do
        py_bin=$(command -v "$py") || continue
        pyver=$(usable "$py_bin") || continue
        [ -f "/opt/omniacli/requirements/$pyver.txt" ] && return 0
    done
    fetch_bundled
    py_bin="$BUNDLED/bin/python3"
    pyver=$(usable "$py_bin") && [ -f "/opt/omniacli/requirements/$pyver.txt" ] && return 0
    echo "omniacli: the bundled Python $py_bin cannot build the venv" >&2
    exit 1
}

# Build the venv and install the dependencies locked for its Python.
# The previous venv (and bundled Python) is kept until the new one is complete.
build_venv() {
    pick_python
    lock="/opt/omniacli/requirements/$pyver.txt"
    rm -rf "$VENV.old"
    [ -d "$VENV" ] && mv "$VENV" "$VENV.old"
    echo "omniacli: installing the Python dependencies ($py_bin, $pyver) in $VENV"
    if "$py_bin" -m venv "$VENV" \
        && "$VENV/bin/pip" install -q --disable-pip-version-check --no-cache-dir -r "$lock" \
        && "$VENV/bin/pip" install -q --disable-pip-version-check --no-cache-dir --no-deps \
            /opt/omniacli/dist/omniacli-*.whl; then
        rm -rf "$VENV.old" "$BUNDLED.old"
        # a local Python took the place of the bundled one
        case "$py_bin" in "$BUNDLED"/*) ;; *) rm -rf "$BUNDLED" ;; esac
    else
        echo "omniacli: the venv could not be built (is PyPI reachable?)" >&2
        rm -rf "$VENV"
        [ -d "$VENV.old" ] && mv "$VENV.old" "$VENV"
        if [ -d "$BUNDLED.old" ]; then
            rm -rf "$BUNDLED"
            mv "$BUNDLED.old" "$BUNDLED"
        fi
        exit 1
    fi
}

# The main config is created once, with a random password for admin, and is
# then the administrator's: upgrades never touch it.
create_config() {
    [ -e "$CONFIG" ] && return 0
    password=$("$VENV/bin/python" -c 'import secrets; print(secrets.token_urlsafe(12))')
    hash=$(OMNIACLI_PW="$password" "$VENV/bin/python" -c \
        'import os; from omniacli.auth import hash_password; print(hash_password(os.environ["OMNIACLI_PW"]))')
    install -d -m 755 /etc/omniacli
    umask 027
    sed "s|@ADMIN_HASH@|$hash|" /usr/share/omniacli/omniacli.yaml.in > "$CONFIG.tmp"
    chgrp omniacli "$CONFIG.tmp"
    chmod 640 "$CONFIG.tmp"
    mv "$CONFIG.tmp" "$CONFIG"
    umask 077
    echo "$password" > "$PASSWORD_FILE"
    umask 022
    echo "omniacli: user 'admin', password in $PASSWORD_FILE (readable by root only)"
}

# The user the service runs as: OMNIACLI_USER of /etc/default/omniacli (read,
# not sourced: systemd reads that file too), omniacli when empty.
service_user() {
    value=$(sed -n 's/^[[:space:]]*OMNIACLI_USER=//p' /etc/default/omniacli 2>/dev/null | tail -n 1 \
        | sed 's/[[:space:]]*$//; s/^"\(.*\)"$/\1/; s/^'"'"'\(.*\)'"'"'$/\1/')
    echo "${value:-omniacli}"
}

# The service runs as user, in group omniacli (it reads the config,
# root:omniacli 640): a drop-in for another user, none for omniacli; the
# data folder and what is in it owned by user, also after a change of user.
apply_service_user() {
    user="$1"
    if [ "$user" = root ] || [ "$(id -u "$user" 2>/dev/null)" = 0 ]; then
        echo "omniacli: OMNIACLI_USER=$user in /etc/default/omniacli: not root" >&2
        exit 1
    fi
    if ! getent passwd "$user" >/dev/null; then
        echo "omniacli: OMNIACLI_USER=$user in /etc/default/omniacli: no such user" >&2
        exit 1
    fi
    if [ "$user" = omniacli ]; then
        rm -f "$USER_DROPIN"
        rmdir "$(dirname "$USER_DROPIN")" 2>/dev/null || true
    else
        install -d -m 755 "$(dirname "$USER_DROPIN")"
        printf '%s\n' "# Written by the omniacli package from OMNIACLI_USER of /etc/default/omniacli:" \
            "# change it there, then sudo dpkg-reconfigure omniacli." \
            "[Service]" "User=$user" "Group=omniacli" > "$USER_DROPIN"
        echo "omniacli: the service runs as $user (OMNIACLI_USER)"
    fi
    if [ "$(stat -c %U "$DATA")" != "$user" ]; then
        chown -R "$user:omniacli" "$DATA"
    fi
    # scripts: the Python scripts the scheduled actions may run (put there by root)
    install -d -o "$user" -g omniacli -m 750 "$DATA" "$DATA/jobs" "$DATA/backups" "$DATA/logs" "$DATA/scripts"
}

case "$1" in
    configure)
        if ! getent passwd omniacli >/dev/null; then
            adduser --quiet --system --group --home /var/lib/omniacli \
                --gecos "OmniaCLI" omniacli
        fi
        # created once: install -d would give an existing one back to omniacli
        [ -d "$DATA" ] || install -d -o omniacli -g omniacli -m 750 "$DATA"
        apply_service_user "$(service_user)"
        build_venv
        create_config
        # the plugins installed from the Plugins page, into the new venv
        [ -x "$VENV/bin/omniacli" ] && "$VENV/bin/omniacli" plugin-install --all || true
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

# systemd, as dh_installsystemd writes it
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ]; then
    # only removes the masks deb-systemd-helper created on package removal
    deb-systemd-helper unmask 'omniacli.service' >/dev/null || true
    # was-enabled is true for a new installation, so it is enabled
    if deb-systemd-helper --quiet was-enabled 'omniacli.service'; then
        deb-systemd-helper enable 'omniacli.service' >/dev/null || true
    else
        deb-systemd-helper update-state 'omniacli.service' >/dev/null || true
    fi
    if [ -d /run/systemd/system ]; then
        systemctl --system daemon-reload >/dev/null || true
        deb-systemd-invoke restart 'omniacli.service' >/dev/null || true
    fi
fi

exit 0
